#include <Atom/Features/SrgSemantics.azsli>
#include <Atom/Features/PostProcessing/FullscreenPixelInfo.azsli>
#include <Atom/Features/PostProcessing/FullscreenVertex.azsli>

ShaderResourceGroup PassSrg : SRG_PerPass
{
    Texture2D<float4> m_player0;
    Texture2D<float4> m_player1;
    Texture2D<float4> m_player2;
    Texture2D<float4> m_player3;
    uint m_playerCount;

    Sampler LinearSampler
    {
        MinFilter = Linear;
        MagFilter = Linear;
        MipFilter = Linear;
        AddressU = Clamp;
        AddressV = Clamp;
        AddressW = Clamp;
    };
}

PSOutput MainPS(VSOutput input)
{
    PSOutput output;
    float2 uv = input.m_texCoord;

    if (PassSrg::m_playerCount == 2)
    {
        if (uv.x < 0.5)
        {
            output.m_color = PassSrg::m_player0.Sample(PassSrg::LinearSampler, float2(uv.x * 2.0, uv.y));
        }
        else
        {
            output.m_color = PassSrg::m_player1.Sample(PassSrg::LinearSampler, float2((uv.x - 0.5) * 2.0, uv.y));
        }
        return output;
    }

    uint column = uv.x >= 0.5;
    uint row = uv.y >= 0.5;
    uint player = row * 2 + column;
    float2 localUv = frac(uv * 2.0);

    if (player == 0)
    {
        output.m_color = PassSrg::m_player0.Sample(PassSrg::LinearSampler, localUv);
    }
    else if (player == 1)
    {
        output.m_color = PassSrg::m_player1.Sample(PassSrg::LinearSampler, localUv);
    }
    else if (player == 2)
    {
        output.m_color = PassSrg::m_player2.Sample(PassSrg::LinearSampler, localUv);
    }
    else if (PassSrg::m_playerCount >= 4)
    {
        output.m_color = PassSrg::m_player3.Sample(PassSrg::LinearSampler, localUv);
    }
    else
    {
        output.m_color = float4(0.0, 0.0, 0.0, 1.0);
    }
    return output;
}
